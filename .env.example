# Copy to .env (gitignored) and fill in. servers/setup.sh reads it.
# The password of admin and Administrator in the server template (lab repo .env: WINDOWS_IMAGE_PASSWORD). After the
# promotion, it's also the password of the domain accounts DISKLESS\admin and DISKLESS\Administrator.
ADMIN_PASSWORD=
# Directory Services Restore Mode password for the domain controller: 16+ letters and digits
DSRM_PASSWORD=

#!ipxe
# The build VM's boot while image/build.sh builds a golden image (docs/golden-image.md). Its own script,
# clients/<mac>.ipxe, which build.sh writes for each phase of the build (image/dc/build-script.ps1), sets initiator-iqn,
# root-path (the build target) and build-phase, then chains this:
#   setup    WinPE, with the blank build disk attached. WinPE fetches the build's job, jobs/<mac>.cmd, which installs
#            Windows onto the disk and powers off.
#   windows  the disk's Windows, which provisions itself, then sysprep powers off.

# Windows sends iSCSI through the gateway in the iBFT, even to a target on its own subnet, and a gateway that doesn't
# route it back to the subnet breaks the connection. iPXE copies the NIC's gateway into the iBFT, so it's cleared first.
# Everything iPXE fetches is on this subnet.
set net0/gateway 0.0.0.0
goto ${build-phase} || goto failed

:setup
echo Building a golden image on ${root-path}: WinPE and setup
sanhook ${root-path} || goto failed
kernel wimboot || goto failed
initrd winpe/BCD BCD || goto failed
initrd winpe/boot.sdi boot.sdi || goto failed
initrd winpe/boot.wim boot.wim || goto failed
boot || goto failed

:windows
echo Building a golden image on ${root-path}: Windows
sanboot ${root-path} || goto failed

:failed
echo The build's boot failed. Press a key for an iPXE shell.
prompt
shell
